CompileFlags:
  Add:
    - --target=x86_64-linux-gnu
    - -std=c11
    - -D_DEFAULT_SOURCE
    - -D_POSIX_C_SOURCE=200809L
    - -ID:/Coding/Projects/Linux System Information and Resource Monitoring Tool/OSSP-Project/OSSP-Project/include
    - -isystem
    - //wsl.localhost/Ubuntu/usr/include
    - -isystem
    - //wsl.localhost/Ubuntu/usr/include/x86_64-linux-gnu
    - -isystem
    - //wsl.localhost/Ubuntu/usr/lib/gcc/x86_64-linux-gnu/15/include
Diagnostics:
  UnusedIncludes: None
---
If:
  PathMatch: .*\.h
CompileFlags:
  Add:
    - -x
    - c-header
